# Node Environment
NODE_ENV=production
PORT=5000

# Platform selection: "github" or "gitlab" (default: github)
PLATFORM=gitlab

# GitHub settings (use when PLATFORM=github)
GITHUB_TOKEN=your_github_token_here
GITHUB_REPO=Sterikworks/Ramshackle_Issues

# GitLab settings (use when PLATFORM=gitlab)
GITLAB_TOKEN=your_gitlab_token_here
GITLAB_URL=https://git.ramshacklegame.com
GITLAB_PROJECT_ID=mountainous-development/Ramshackle_Issues
